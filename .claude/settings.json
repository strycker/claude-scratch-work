{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "fable-advisor": {
      "source": {
        "source": "github",
        "repo": "DannyMac180/fable-advisor"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "fable-advisor@fable-advisor": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
