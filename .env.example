# Copy this file to .env and fill in your keys.
# .env is git-ignored — never commit real keys.

# ── Required: FRED API key ────────────────────────────────────────────
FRED_API_KEY=your_fred_api_key_here

# ── Optional: SSL certificate override for yfinance ──────────────────
# Set to "false" to disable SSL certificate verification for yfinance.
# Needed when curl_cffi can't trust your network's certificate chain.
# curl_cffi does NOT use the macOS Keychain or system trust store — adding
# a cert to Keychain has no effect.  This env var is the reliable fix.
# YFINANCE_VERIFY_SSL=false

# ── Optional: Path overrides ────────────────────────────────────────
# Override default project directories (useful for Docker, CI, or custom layouts).
# TC_ROOT_DIR=/path/to/repo
# TC_CONFIG_DIR=/path/to/config
# TC_DATA_DIR=/path/to/data
# TC_OUTPUT_DIR=/path/to/outputs

# ── Optional: Email config via env vars ───────────────────────────────
# These override config/email.local.yaml values.
# Useful for CI/CD, Docker, or PyPI-only installs without YAML files.
# TC_SMTP_HOST=smtp.gmail.com
# TC_SMTP_PORT=587
# TC_SMTP_USER=your_email@gmail.com
# TC_SMTP_PASSWORD=your_app_password_here
# TC_EMAIL_FROM=your_email@gmail.com
# TC_EMAIL_TO=recipient@example.com
# TC_EMAIL_USE_TLS=true
# TC_EMAIL_USE_SSL=false

# ── Tiingo (daily price universe — first source in the price fallback chain) ──
# Free key: https://www.tiingo.com  (free tier covers daily EOD for equities/ETFs)
# Without this the pipeline falls through to yfinance and Stooq, both of which
# are commonly blocked by bot checks or TLS interception on some networks.
# TIINGO_API_KEY=your_tiingo_key_here

# ── CA bundle (only needed on TLS-intercepting networks) ─────────────────────
# curl_cffi ignores the macOS Keychain and SSL_CERT_FILE. If TLS verification
# fails with "self signed certificate in certificate chain", build a combined
# bundle with scripts/fix_local_ca.sh and set an ABSOLUTE path here (a .env
# file does not expand ~ or $HOME).
# TC_CA_BUNDLE=/Users/you/.trading-crab-ca.pem
