# Root MANIFEST.in — for the `trading-crab` app sdist
# The library (`trading-crab-lib`) has its own MANIFEST.in at src/trading_crab_lib/

include LICENSE
include README.md
include pyproject.toml

# App package lives at src/trading_crab/
recursive-include src/trading_crab *.py py.typed

# The library is a separate sdist — exclude it from the app sdist
prune src/trading_crab_lib

# Exclude repo-only files
exclude run_pipeline.py
exclude config/email.yaml
exclude config/email.local.yaml

prune gsd-scratch-work
prune trading-crab-lib
prune trading-crab

prune pipelines
prune scripts
prune notebooks
prune legacy
prune config
prune tests

prune data
prune outputs

global-exclude .env
global-exclude email.yaml
global-exclude email.local.yaml

global-exclude *.pyc
global-exclude __pycache__
global-exclude .DS_Store

