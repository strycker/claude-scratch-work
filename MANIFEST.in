include LICENSE
include README.md
include pyproject.toml
recursive-include src/trading_crab_lib py.typed
exclude config/email.yaml
exclude config/email.local.yaml


prune gsd-scratch-work
prune trading-crab-lib
prune trading-crab

prune pipelines
prune scripts
prune notebooks

exclude run_pipeline.py

prune config

prune data
prune outputs

global-exclude .env
global-exclude email.yaml
global-exclude email.local.yaml

global-exclude *.pyc
global-exclude __pycache__
global-exclude .DS_Store

