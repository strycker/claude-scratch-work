# Environment
.env
*.env
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Stray duplicate created by `python -m build src/trading_crab_lib` (setuptools
# packages.find with where=[".."] re-discovers the package one level down when
# built from inside its own subdirectory). Never commit — a second copy of the
# library nested inside itself breaks package discovery. Delete after building.

# Jupyter
.ipynb_checkpoints/

# Data — raw/processed data should not be versioned
data/raw/

# Platform NOTEBOOK scratch checkpoint namespace (plotting/loaders.py
# NOTEBOOK_SCRATCH_DIR). Notebooks route label_regimes() writes here so they can
# never touch the tracked production namespace at data/checkpoints/platform/
# (D-10, threat T-06-12). Because that production namespace IS tracked in this
# repo, the scratch twin must be ignored explicitly — otherwise every P3 run
# leaves untracked files one `git add data/` away from being committed.
data/checkpoints/platform_notebook/
# data/processed/
# data/regimes/
# outputs/figures/
# outputs/models/
# outputs/plots/
# outputs/reports/

# Offline dev snapshots — deliberately committed (docs/offline_snapshots.md).
# Narrowest possible exception: only this subtree, nothing else under data/.
!data/snapshots/
!data/snapshots/**

# Secrets / API keys (always use .env instead)
*.key
config/secrets.yaml
config/email.yaml
config/email.local.yaml
config/portfolio.local.yaml
*pem

# Account holdings — real per-account weights are secrets-adjacent (L4-03,
# 04-CONTEXT D-01); only the obviously-fake schema doc is tracked.
config/accounts/*.yaml
!config/accounts/example.yaml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Claude Code — env-specific local settings. GSD writes absolute node/hook paths
# here that differ per machine (e.g. /opt/node22/bin/node in web sessions), so it
# is regenerated by the GSD install in each environment. The committed
# .claude/settings.json holds the portable, shared plugin config.
.claude/settings.local.json


# GSD ephemeral agent worktrees (live isolation dirs; never commit)
.claude/worktrees/
